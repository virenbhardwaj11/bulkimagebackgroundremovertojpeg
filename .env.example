# PDF Background Removal Configuration

# PDF rendering DPI (higher = better quality but slower & more memory)
RENDER_DPI=200

# Max dimension (width or height) to resize images before background removal
MAX_IMAGE_DIMENSION=2048

# JPEG export quality (0-100)
JPEG_QUALITY=95

# Background removal model (u2net is recommended for CPU speed)
REMBG_MODEL=u2net

# Alpha matting (True/False). True provides better edges but is very slow on CPU.
ALPHA_MATTING=False

# Number of concurrent workers for background removal
MAX_WORKERS=1

# Upload limits
MAX_UPLOAD_SIZE_MB=15
MAX_TOTAL_UPLOAD_MB=500
